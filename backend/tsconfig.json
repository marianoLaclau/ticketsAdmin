{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "strictFunctionTypes": true,
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../lib/db"
    },
    {
      "path": "../lib/api-zod"
    },
    {
      "path": "../lib/ingesta"
    },
    {
      "path": "../lib/password-policy"
    }
  ]
}
