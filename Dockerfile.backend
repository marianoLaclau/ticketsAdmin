# syntax=docker/dockerfile:1
#
# Build context must be the repo root (monorepo): the backend depends on
# workspace packages (lib/db, lib/api-zod) resolved via pnpm workspaces.

FROM node:24-slim AS builder

# python3/make/g++ are a fallback in case better-sqlite3 has no prebuilt
# binary for this exact Node/OS/arch combo and needs to compile from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY scripts/package.json ./scripts/package.json
COPY lib/api-client-react/package.json ./lib/api-client-react/package.json
COPY lib/api-spec/package.json ./lib/api-spec/package.json
COPY lib/api-zod/package.json ./lib/api-zod/package.json
COPY lib/db/package.json ./lib/db/package.json
COPY lib/ingesta/package.json ./lib/ingesta/package.json
COPY lib/password-policy/package.json ./lib/password-policy/package.json
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @workspace/backend run build

# Produces a self-contained, non-symlinked node_modules with only the
# backend's production dependencies (this is what makes better-sqlite3's
# native binary resolvable at runtime without dragging pnpm's whole
# symlink-based store into the final image).
RUN pnpm --filter @workspace/backend deploy --prod --legacy /prod/backend

FROM node:24-slim AS runtime
ARG TICKETSADMIN_IMAGE_REVISION=development
ARG TICKETSADMIN_IMAGE_SOURCE=local

LABEL org.opencontainers.image.revision="${TICKETSADMIN_IMAGE_REVISION}" \
      org.opencontainers.image.source="${TICKETSADMIN_IMAGE_SOURCE}"

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /prod/backend/node_modules ./node_modules
COPY --from=builder /app/lib/db/drizzle ./drizzle

EXPOSE 5000
# Aplica las migraciones pendientes (idempotente) y recién después levanta la API.
CMD ["sh", "-c", "node dist/migrate.mjs && exec node --enable-source-maps dist/index.mjs"]
