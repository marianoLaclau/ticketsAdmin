# syntax=docker/dockerfile:1
#
# Build context must be the repo root (monorepo): the frontend depends on
# lib/api-client-react and lib/api-zod resolved via pnpm workspaces.

FROM node:24-slim AS builder
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY scripts/package.json ./scripts/package.json
COPY lib/api-client-react/package.json ./lib/api-client-react/package.json
COPY lib/api-spec/package.json ./lib/api-spec/package.json
COPY lib/api-zod/package.json ./lib/api-zod/package.json
COPY lib/db/package.json ./lib/db/package.json
COPY lib/ingesta/package.json ./lib/ingesta/package.json
COPY lib/password-policy/package.json ./lib/password-policy/package.json
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @workspace/frontend run build

FROM nginx:1.27-alpine AS runtime
ARG TICKETSADMIN_IMAGE_REVISION=development
ARG TICKETSADMIN_IMAGE_SOURCE=local
ARG TICKETSADMIN_RELEASE_ID=development

LABEL org.opencontainers.image.revision="${TICKETSADMIN_IMAGE_REVISION}" \
      org.opencontainers.image.source="${TICKETSADMIN_IMAGE_SOURCE}" \
      io.ticketsadmin.release-id="${TICKETSADMIN_RELEASE_ID}"

COPY --from=builder /app/frontend/dist/public /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
