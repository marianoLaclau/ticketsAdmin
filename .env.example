# Copiar a .env y completar

# Puerto del backend (el frontend en dev proxea /api hacia este puerto)
PORT=5000

# IP de esta máquina en la red interna. n8n (nodo HTTP Request) apunta a
# http://HOST_IP:PORT/api/webhooks/ticket para postear cada llamada.
# Actualizar este valor cuando cambie la IP o se mude a otro servidor.
HOST_IP=192.168.1.100

# API key que n8n debe mandar en el header "x-api-key" al POSTear a
# /api/webhooks/ticket. Generar, por ejemplo, con: openssl rand -hex 32
WEBHOOK_API_KEY=

# Segunda credencial obligatoria del panel SysAdmin. La UI la manda en el
# header "x-admin-key". Debe ser distinta de WEBHOOK_API_KEY; generar con:
# openssl rand -hex 32
ADMIN_API_KEY=

# Solo para una base sin password_hash o con la credencial semilla heredada.
# Debe tener entre 16 y 128 caracteres, sin controles ni espacios exteriores,
# placeholders públicos o un único carácter repetido. El backend guarda un
# hash, nunca este valor. La credencial emitida es temporal: sysadmin debe
# reemplazarla al iniciar sesión. Luego el backend ignora la variable mientras
# la credencial permanezca segura.
BOOTSTRAP_SYSADMIN_PASSWORD=

# Ruta del archivo SQLite (opcional, por defecto <repo>/data/tickets.db)
# TICKETS_DB_PATH=C:\otra\ruta\tickets.db

# Timezone del backend (filtros por día calendario y fechas locales)
TZ=America/Argentina/Buenos_Aires

# Frecuencia de revisión del SLA para elevar prioridades (opcional).
# Default: 300000 ms (5 minutos); mínimo aceptado: 10000 ms.
PRIORIDAD_AUTOMATICA_INTERVAL_MS=300000
