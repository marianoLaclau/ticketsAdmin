{
  "name": "workspace",
  "version": "0.5.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');['package-lock.json','yarn.lock'].forEach(f=>fs.rmSync(f,{force:true}));if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm instead');process.exit(1)}\"",
    "backup:db": "pnpm --filter @workspace/scripts run backup-db",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "codegen:check": "pnpm run codegen && pnpm --filter @workspace/scripts run check-generated-code",
    "format": "prettier --write \"**/*.{cjs,css,js,json,jsx,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{cjs,css,js,json,jsx,mjs,ts,tsx,yaml,yml}\"",
    "lint": "eslint backend e2e frontend lib scripts --ext .ts,.tsx --max-warnings 0",
    "schema:check": "pnpm --filter @workspace/db exec drizzle-kit check --config ./drizzle.config.ts",
    "test": "pnpm --workspace-concurrency=1 -r --if-present run test",
    "test:e2e": "pnpm --filter @workspace/e2e run test:e2e",
    "test:e2e:headed": "pnpm --filter @workspace/e2e run test:e2e:headed",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run codegen:check && pnpm run schema:check && pnpm test && pnpm run build",
    "restore:db": "pnpm --filter @workspace/scripts run restore-db",
    "typecheck:libs": "tsc --build",
    "typecheck:runtime": "pnpm -r --filter \"./backend\" --filter \"./frontend\" --filter \"./scripts\" --if-present run typecheck:src",
    "typecheck:tests": "pnpm -r --if-present run typecheck:test",
    "typecheck": "pnpm run typecheck:libs && pnpm run typecheck:runtime && pnpm run typecheck:tests",
    "verify:db": "pnpm --filter @workspace/scripts run verify-db"
  },
  "packageManager": "pnpm@11.13.1",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
