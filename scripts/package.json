{
  "name": "@workspace/scripts",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup-db": "tsx ./src/backup-db.ts",
    "check-generated-code": "tsx ./src/check-generated-code.ts",
    "import-excel": "tsx ./src/import-excel.ts",
    "restore-db": "tsx ./src/restore-db.ts",
    "test": "tsx --test ./test/*.test.ts",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:test",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify-db": "tsx ./src/verify-db.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/ingesta": "workspace:*",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
